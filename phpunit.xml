<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="https://schema.phpunit.de/9.6/phpunit.xsd"
         bootstrap="tests/bootstrap.php"
         backupGlobals="false"
         colors="true"
         beStrictAboutOutputDuringTests="false"
         beStrictAboutTodoAnnotatedTests="false"
         failOnRisky="false"
         failOnWarning="false"
         verbose="true">
    <php>
        <ini name="intl.default_locale" value="en"/>
        <ini name="intl.error_level" value="0"/>
        <ini name="memory_limit" value="-1"/>
        <ini name="error_reporting" value="E_ALL"/>
        <ini name="display_errors" value="1"/>
        <ini name="log_errors" value="0"/>
        <ini name="display_startup_errors" value="1"/>
        <const name="WP_TESTS_DIR" value="/tmp/wordpress-tests-lib"/>
        <const name="WP_TESTS_MULTISITE" value="0"/>
        <env name="WP_TESTS_DB_NAME" value="wp_test"/>
        <env name="WP_TESTS_DB_USER" value="root"/>
        <env name="WP_TESTS_DB_PASSWORD" value=""/>
        <env name="WP_TESTS_DB_HOST" value="localhost"/>
    </php>
    <testsuites>
        <testsuite name="default">
            <directory>tests</directory>
            <exclude>tests/Ajax/RosterAjaxHandlerTest.php</exclude>
            <exclude>tests/Core/ActivatorTest.php</exclude>
            <exclude>tests/Core/DatabaseTest.php</exclude>
            <exclude>tests/Core/DependenciesTest.php</exclude>
            <exclude>tests/Core/PluginTest.php</exclude>
            <exclude>tests/Data/Collections/PlayersCollectionTest.php</exclude>
            <exclude>tests/Data/Collections/RostersCollectionTest.php</exclude>
            <exclude>tests/Data/Repositories/PlayerRepositoryTest.php</exclude>
            <exclude>tests/Data/Repositories/RosterRepositoryTest.php</exclude>
            <exclude>tests/Integration/OrderToRosterFlowTest.php</exclude>
            <exclude>tests/Integration/RosterQueryHelperTest.php</exclude>
            <exclude>tests/Integration/RosterRebuildTest.php</exclude>
            <exclude>tests/Legacy/AjaxHandlersTest.php</exclude>
            <exclude>tests/Legacy/DatabaseOperationsTest.php</exclude>
            <exclude>tests/Legacy/EventSignatureNormalizationTest.php</exclude>
            <exclude>tests/Legacy/MigrationLanguageNormalizationTest.php</exclude>
            <exclude>tests/Legacy/RosterDetailsUrlTest.php</exclude>
            <exclude>tests/Legacy/RosterExportTest.php</exclude>
            <exclude>tests/Legacy/TournamentDateExtractionTest.php</exclude>
            <exclude>tests/Legacy/UtilsTest.php</exclude>
            <exclude>tests/Services/CacheManagerTest.php</exclude>
            <exclude>tests/Services/RosterBuilderTest.php</exclude>
            <exclude>tests/Reports/CampReportTest.php</exclude>
            <exclude>tests/Reports/OverviewReportTest.php</exclude>
            <exclude>tests/WooCommerce/DiscountCalculatorTest.php</exclude>
            <exclude>tests/Services/OrderFinancialAttributionServiceTest.php</exclude>
            <exclude>tests/Services/PlayerMatcherTest.php</exclude>
            <exclude>tests/Services/PricingCalculatorTest.php</exclude>
        </testsuite>
        <testsuite name="Production">
            <file>tests/Core/LoggerTest.php</file>
            <file>tests/Core/ActivationRequirementsTest.php</file>
            <file>tests/Core/CommittedPluginAutoloadTest.php</file>
            <file>tests/WarmupBootstrapTest.php</file>
            <file>tests/Reports/FinalReportsTotalsTest.php</file>
            <file>tests/Reports/BookingReportTotalsHtmlTest.php</file>
            <file>tests/Reports/FinalReportsAggregationAccuracyTest.php</file>
            <file>tests/Reports/FinalReportsUrgencyTest.php</file>
            <file>tests/Reports/EvergreenYearIsolationTest.php</file>
            <file>tests/Reports/CanonicalOrderMetaPreferenceTest.php</file>
            <file>tests/Reports/DistressedVariationIdsTest.php</file>
            <file>tests/Reports/PlayerCampStatusTest.php</file>
            <file>tests/Reports/PlayerCourseStatusTest.php</file>
            <file>tests/Reports/PlayerCourseStatusQueryCountTest.php</file>
            <file>tests/Reports/PlayerCourseStatusPendingTest.php</file>
            <file>tests/Reports/PlayerCourseStatusAdminUiTest.php</file>
            <file>tests/Reports/PlayerCourseStatusStrictDateTest.php</file>
            <file>tests/Reports/PlayerCourseStatusLoadPlayersQueryCountTest.php</file>
            <file>tests/Reports/PlayerCourseStatusGoldenTest.php</file>
            <file>tests/Reports/PlayerCourseStatusMemoryTest.php</file>
            <file>tests/Reports/PlayerCourseStatusSeasonLabelTest.php</file>
            <file>tests/Reports/PlayerCourseStatusCacheTest.php</file>
            <file>tests/Reports/PlayerCourseStatusPerfBaseCacheTest.php</file>
            <file>tests/Reports/PlayerCourseStatusWarmPathQueryTest.php</file>
            <file>tests/Reports/PlayerCourseStatusLegacyEquivalenceTest.php</file>
            <file>tests/Reports/WinbackReportCacheTest.php</file>
            <file>tests/Reports/PlayerCampStatusLoadPlayersQueryCountTest.php</file>
            <file>tests/Reports/WinbackReportTest.php</file>
            <file>tests/Reports/WinbackReportAdminUiTest.php</file>
            <file>tests/Reports/WinbackCatalogueWpmlTest.php</file>
            <file>tests/Reports/WinbackCatalogueFu11Test.php</file>
            <file>tests/Reports/WinbackCatalogueFu12Test.php</file>
            <file>tests/Reports/WinbackReportQueryCountTest.php</file>
            <file>tests/Reports/WinbackReportRuntimeCacheFlushTest.php</file>
            <file>tests/Reports/WinbackReportMemoryTest.php</file>
            <file>tests/Reports/FinalReportsMetaTest.php</file>
            <file>tests/Campaign/Final15CampaignFixtureTest.php</file>
            <file>tests/Campaign/CampaignMomentumTest.php</file>
            <file>tests/Services/RosterCanonicalFieldsTest.php</file>
            <file>tests/Services/RosterRefundServiceTest.php</file>
            <file>tests/Services/RosterExportRefundFilterTest.php</file>
            <file>tests/Ajax/RosterVenueAccessTest.php</file>
            <file>tests/Unit/RosterDaysUnknownTest.php</file>
            <file>tests/Reports/OrderMetaFieldMapTest.php</file>
            <file>tests/Services/RosterBuilderSingleDayTest.php</file>
            <file>tests/Services/DataValidatorSingleDayUnknownTest.php</file>
            <file>tests/Unit/RosterCampBookingDisplayTest.php</file>
            <file>tests/Unit/BookingTypeNormalizerTest.php</file>
            <file>tests/Unit/MedicalAccessTest.php</file>
            <file>tests/Unit/MedicalAccessSplitPermissionsTest.php</file>
            <file>tests/Unit/MedicalAccessPmMissingTest.php</file>
            <file>tests/Unit/MedicalRosterAjaxTest.php</file>
            <file>tests/Unit/RosterExportMedicalGatingTest.php</file>
            <file>tests/Unit/RosterExportAllMedicalGatingTest.php</file>
            <file>tests/Unit/RosterSingleExportSplitPermissionsTest.php</file>
            <file>tests/Unit/MedicalRosterEditorDobGateTest.php</file>
            <file>tests/Unit/PlayerCampStatusDobGatingTest.php</file>
            <directory>tests/ReportAccuracy</directory>
        </testsuite>
        <testsuite name="Complete">
            <directory>tests</directory>
        </testsuite>
    </testsuites>
    <coverage processUncoveredFiles="true">
        <include>
            <directory suffix=".php">classes</directory>
            <directory suffix=".php">includes</directory>
        </include>
        <exclude>
            <directory>vendor</directory>
            <directory>tests</directory>
            <file>intersoccer-reports-rosters.php</file>
            <file>classes/services/validation-tests.php</file>
            <file>classes/data/models/players.php.old</file>
        </exclude>
        <report>
            <html outputDirectory="coverage/html"/>
            <text outputFile="php://stdout" showUncoveredFiles="false"/>
            <clover outputFile="coverage/clover.xml"/>
        </report>
    </coverage>
</phpunit>
